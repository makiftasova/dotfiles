#!/usr/bin/env python3

"""A simple wrapper for python-playwright to use it as MCP server"""

import os
import sys
from pathlib import Path

try:
    import playwright
except ImportError:
    raise SystemExit("Please install 'python-playwright' module.")

driver = Path(playwright.__file__).resolve().parent / "driver"
node = driver / "node"
entry = driver / "package" / "lib" / "entry" / "mcp.js"

if not node.is_file() or not entry.is_file():
    raise SystemExit(
        "The installed python-playwright package does not contain "
        "the expected MCP entry point."
    )

os.execv(
    str(node),
    [str(node), str(entry), *sys.argv[1:]],
)
