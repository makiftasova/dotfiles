#!/usr/bin/env bash
#
# Start a split-tunnel WireGuard namespace.
#
# $1 wireguard config file
# $2 network namespace name
#
# Design: all tunnel state (wg interface, addresses, peer, routes, DNS) lives
# inside the isolation namespace, so the host namespace is never touched. The
# only bridge to the outside world is a single veth pair used for the control
# path (reaching the WireGuard endpoint). Because the namespace's default route
# is the tunnel itself, and the peer AllowdIPs is 0.0.0.0/0, the handshake to
# the endpoint would otherwise be routed back into the tunnel and never
# complete. The veth + a more-specific endpoint route fixes that without
# leaking anything into the host.

set -euo pipefail

CONFIG_PATH="${1}"
NETNS_NAME="${2:-wgvpn}"

WG_IFACE="${NETNS_NAME}0"

# Point-to-point subnet for the veth (control/endpoint path only).
# Default to TEST-NET-2 (RFC 5737, documentation-reserved) so it cannot
# collide with docker/podman bridges, Tailscale (100.64.0.0/10), or any
# common LAN. Override via the VPN_VETH_* variables if you need a specific
# range.
VETH_SUBNET="${VPN_VETH_SUBNET:-198.18.0.0/30}"
HOST_VETH="${NETNS_NAME}-h"
CLIENT_VETH="${NETNS_NAME}-c"
HOST_VETH_IP="${VPN_VETH_HOST_IP:-198.18.0.1/30}"
CLIENT_VETH_IP="${VPN_VETH_CLIENT_IP:-198.18.0.2/30}"
# Per-namespace nftables table for the control-path NAT (avoids clashing with
# any other namespace started the same way).
NFT_TABLE="wg_split_${NETNS_NAME}"

require_root() {
	if [[ "$(id -u)" -ne 0 ]]; then
		echo "Error: this script must run as root." >&2
		exit 255
	fi
}

# Remove leftovers from a previous run so the script is idempotent.
cleanup_previous() {
	ip netns del "${NETNS_NAME}" 2>/dev/null || true
	# Deleting the netns destroys the namespace-side veth; drop the host-side peer.
	ip link del "${HOST_VETH}" 2>/dev/null || true
	clear_nat
}

nft_exists() { command -v nft >/dev/null 2>&1; }

# Remove the control-path NAT table if it exists (idempotent per namespace).
# nft is synchronous by default (each command waits on the kernel's netlink
# ack before returning), so no wait flag is needed - and there is none: this
# nftables build has no -w/--wait option.
clear_nat() {
	if nft_exists; then
		nft delete table ip "${NFT_TABLE}" 2>/dev/null || true
	fi
}

# Add the control-path NAT: packets entering via the host-side veth get
# masqueraded to the egress IP. Matching on iifname + saddr keeps it from
# ever touching Tailscale / podman / LAN traffic, even if a subnet overlapped.
nft_add_nat() {
	nft add table ip "${NFT_TABLE}"
	nft add chain ip "${NFT_TABLE}" srcnat \
		'{ type nat hook postrouting priority srcnat; policy accept; }'
	nft add rule ip "${NFT_TABLE}" srcnat \
		iifname "${HOST_VETH}" ip saddr "${VETH_SUBNET}" masquerade
}

# Refuse to start if either end of the veth already has an IP on this host,
# so we never clobber a container bridge / Tailscale / LAN address.
check_ip_unused() {
	local cand="${1%/}"
	cand="${cand#/}"
	local existing
	existing="$(ip -4 -o addr show 2>/dev/null | awk '{print $4}' | sed 's#/.*##' || true)"
	if printf '%s\n' "${existing}" | grep -qx "${cand}"; then
		die "IP ${cand} is already in use on this host; choose a different VPN_VETH_SUBNET."
	fi
}

die() { echo "Error: $*" >&2; exit 255; }

[[ -r "${CONFIG_PATH}" ]] || die "${CONFIG_PATH} does not exist or is not readable!"

# --- Parse the config -------------------------------------------------------
CONFIG_FILE="$(<"${CONFIG_PATH}")"

ADDR_LINE="$(echo "${CONFIG_FILE}" | grep '^Address' || true)"
ADDR_4=$(echo "${ADDR_LINE}" | awk -F'[ =,]' '{print $4}' || true)
ADDR_6=$(echo "${ADDR_LINE}" | awk -F'[ =,]' '{print $5}' || true)

DNS="$(echo "${CONFIG_FILE}" | grep '^DNS' | awk -F'[ =,]' '{print $4}' || true)"
[[ -n "${DNS}" ]] || DNS='1.1.1.1'

ENDPOINT="$(echo "${CONFIG_FILE}" | grep '^Endpoint' | awk -F'[ =,]' '{print $4}' || true)"
EP_IP="${ENDPOINT%%:*}"
[[ -n "${EP_IP}" ]] || die "No Endpoint with an IP found in ${CONFIG_PATH}."

# Strip Address and DNS (handled separately); the peer stays in the netns.
BASE_CONFIG="$(echo "${CONFIG_FILE}" | sed '/^Address/d' | sed '/^DNS/d')"

echo "Namespace: ${NETNS_NAME}"
echo "IPv4: ${ADDR_4}"
echo "IPv6: ${ADDR_6:-n/a}"
echo "DNS: ${DNS}"
echo "Endpoint: ${ENDPOINT}"

# --- Set up the namespace ---------------------------------------------------
require_root
cleanup_previous

# Fail fast if our veth IPs are already claimed by something else on the host.
check_ip_unused "${HOST_VETH_IP}"
check_ip_unused "${CLIENT_VETH_IP}"

mkdir -p "/etc/netns/${NETNS_NAME}"
cat > "/etc/netns/${NETNS_NAME}/resolv.conf" <<EOF
nameserver ${DNS}
EOF

ip netns add "${NETNS_NAME}" || die "cannot create netns ${NETNS_NAME}"
ip netns exec "${NETNS_NAME}" ip link set lo up || die "cannot bring up loopback in ${NETNS_NAME}"

# Control path: a veth from the namespace to the host uplink.
ip link add "${HOST_VETH}" type veth peer name "${CLIENT_VETH}" \
	|| die "cannot create veth pair for ${NETNS_NAME}"
ip link set "${HOST_VETH}" up
ip link set "${CLIENT_VETH}" netns "${NETNS_NAME}"
ip netns exec "${NETNS_NAME}" ip link set "${CLIENT_VETH}" up
ip netns exec "${NETNS_NAME}" ip addr add "${CLIENT_VETH_IP}" dev "${CLIENT_VETH}"
ip addr add "${HOST_VETH_IP}" dev "${HOST_VETH}"

# Let the namespace reach the endpoint through the veth.
ip netns exec "${NETNS_NAME}" ip route add "${EP_IP}/32" dev "${CLIENT_VETH}" \
	|| die "cannot route endpoint in ${NETNS_NAME}"

# --- WireGuard interface (keeps living inside the namespace) ---------------
ip link add dev "${WG_IFACE}" type wireguard || die "cannot create wg iface ${WG_IFACE}"
ip link set "${WG_IFACE}" netns "${NETNS_NAME}"

ip netns exec "${NETNS_NAME}" wg setconf "${WG_IFACE}" /dev/stdin <<<"${BASE_CONFIG}" \
	|| die "cannot set wg config for ${WG_IFACE}"
ip netns exec "${NETNS_NAME}" ip addr add "${ADDR_4}" dev "${WG_IFACE}" \
	|| die "cannot set wg IPv4 address"
if [[ -n "${ADDR_6}" ]]; then
	ip netns exec "${NETNS_NAME}" ip -6 addr add "${ADDR_6}" dev "${WG_IFACE}" \
		|| die "cannot set wg IPv6 address"
fi

ip netns exec "${NETNS_NAME}" ip link set "${WG_IFACE}" up \
	|| die "cannot bring up ${WG_IFACE}"

ip netns exec "${NETNS_NAME}" ip route add default dev "${WG_IFACE}" \
	|| die "cannot set default IPv4 route in ${NETNS_NAME}"
if [[ -n "${ADDR_6}" ]]; then
	ip netns exec "${NETNS_NAME}" ip -6 route add default dev "${WG_IFACE}" \
		|| die "cannot set default IPv6 route in ${NETNS_NAME}"
fi

# --- Make the control path actually egress the host ------------------------
# The handshake to the endpoint must leave via the physical uplink. NAT the
# veth subnet (and only that subnet) so the reply can come back to us.
sysctl -w net.ipv4.ip_forward=1 >/dev/null
if ! nft_exists; then
	die "nft not found; cannot add NAT for the control path."
fi
nft_add_nat || die "cannot add nft NAT for ${VETH_SUBNET}"

# --- Verify (so 'success' is actually true) --------------------------------
# A successful outbound request through the tunnel is only possible once a
# WireGuard handshake has completed, so probing the data path directly is the
# authoritative check. We retry a few times in case the first handshake is
# still in flight.
DATA_OK=0
try=0
while ((try < 3)); do
	if ip netns exec "${NETNS_NAME}" curl -4 -s --max-time 6 --output /dev/null \
		https://ifconfig.me 2>/dev/null; then
		DATA_OK=1
		break
	fi
	try=$((try + 1))
done

if [[ "${DATA_OK}" -eq 1 ]]; then
	# Show peer evidence so "up" is backed by something concrete.
	ip netns exec "${NETNS_NAME}" wg show "${WG_IFACE}" 2>/dev/null | grep -iE 'handshake|endpoints|transfer' || true
	echo "SUCCESS: split tunnel is up; traffic is egressing via the tunnel."
else
	echo "FAILED: no working data path through the split tunnel." >&2
	echo "--- peer state (for diagnosis) ---" >&2
	ip netns exec "${NETNS_NAME}" wg show "${WG_IFACE}" >&2 || true
	ip netns exec "${NETNS_NAME}" ip -4 route show table main >&2 || true
	exit 1
fi

exit 0
