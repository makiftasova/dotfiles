FROM debian:stable-slim

# Avoid warnings by switching to noninteractive
ARG DEBIAN_FRONTEND=noninteractive

ARG SSH_PUBKEY=""
ARG USERNAME="makiftasova"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl fzf foot-extra-terminfo git locales ncurses-term \
        openssh-client openssh-server python3 python3-yaml remmina \
        remmina-plugin-vnc sudo tigervnc-viewer tmux vim wayvnc zsh \
 && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
 && locale-gen \
 && curl -fsSL https://tailscale.com/install.sh \
        -o /tmp/install-tailscale.sh \
 && sh /tmp/install-tailscale.sh \
 && rm -f /tmp/install-tailscale.sh \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Set the default locale and tell systemd it is running in Podman
ENV LANG=en_US.UTF-8 \
    container=podman

# Make sure correct locales are generated and in use.
RUN test "$(locale charmap)" = "UTF-8"

# Create a regular user and give it sudo rights
RUN useradd --create-home --user-group --shell /bin/zsh "$USERNAME" \
 && usermod --append --groups sudo "$USERNAME" \
 && printf '%s ALL=(ALL:ALL) NOPASSWD:ALL\n' "$USERNAME" > "/etc/sudoers.d/$USERNAME" \
 && chmod 0440 "/etc/sudoers.d/$USERNAME" \
 && visudo --check --strict

# Generate host keys, configure sshd, validate it, and enable services
RUN ssh-keygen -A \
 && printf '%s\n' \
        'PermitRootLogin no' 'PasswordAuthentication no' \
        'KbdInteractiveAuthentication no' 'PubkeyAuthentication yes' \
        'AuthenticationMethods publickey' "AllowUsers ${USERNAME}" \
        'AllowTcpForwarding local' \
        > /etc/ssh/sshd_config.d/00-isolated-workspace.conf \
 && chmod 0644 /etc/ssh/sshd_config.d/00-isolated-workspace.conf \
 && /usr/sbin/sshd -t \
 && systemctl enable tailscaled.service ssh.service


# Set up user files
USER $USERNAME
WORKDIR /home/$USERNAME

# Add provided ssh pubkey to user's authorized_keys
RUN if [ -n "$SSH_PUBKEY" ]; then \
        install -d -m 0700 .ssh; \
        printf '%s\n' "$SSH_PUBKEY" > .ssh/authorized_keys; \
        chmod 0600 .ssh/authorized_keys; \
    fi

RUN git clone --depth 1 https://codeberg.org/makiftasova/dotfiles.git dotfiles

# Install oh-my-zsh
RUN curl -fsSL \
        https://raw.githubusercontent.com/robbyrussell/oh-my-zsh/master/tools/install.sh \
        -o /tmp/install-oh-my-zsh.sh \
 && RUNZSH=no CHSH=no sh /tmp/install-oh-my-zsh.sh \
 && rm -f /tmp/install-oh-my-zsh.sh

# Make sure `.zshrc from `dotfiles` is used
RUN rm -f .zshrc && ./dotfiles/install --only link

# Switch back to root so systemd can boot as PID 1
USER root
WORKDIR /

# Disable oh-my-zsh auto-update
ENV DISABLE_AUTO_UPDATE=true

# Try to preserve user home directory and tailscale login
VOLUME ["/home/$USERNAME"]
VOLUME ["/var/lib/tailscale"]

# Start systemd init
CMD ["/lib/systemd/systemd"]
