[Unit]
Description=Isolated Workspace Container
After=network-online.target
Wants=network-online.target

[Container]
Image=isolated-workspace:latest
ContainerName=isolated-workspace
HostName=makiftasova-remote
Exec=/lib/systemd/systemd

# Enable UID/GID mapping for rootless user mounts
UserNS=keep-id:uid=1000,gid=1000

# Required permissions for isolated Tailscale network
AddCapability=CAP_NET_ADMIN
AddCapability=CAP_NET_RAW
AddDevice=/dev/net/tun:/dev/net/tun

# Enable cgroups for systemd inside the container
Volume=/sys/fs/cgroup:/sys/fs/cgroup:rw

# Persist Tailscale state across container restarts
Volume=isolated-workspace-home:/home/makiftasova:rw
Volume=isolated-workspace-tailscale:/var/lib/tailscale

# Keeps the container running cleanly under systemd
Environment=container=podman

# Mount wayland socket for gui apps
Volume=%t/wayland-1:%t/wayland-1:ro
Environment=XDG_RUNTIME_DIR=%t
Environment=WAYLAND_DISPLAY=wayland-1
Environment=QT_QPA_PLATFORM=wayland
Environment=GDK_BACKEND=wayland

[Service]
Restart=always
RestartSec=10s
TimeoutStartSec=300
CPUQuota=200%
MemoryMax=4G

[Install]
# Auto-start on user login
WantedBy=default.target
