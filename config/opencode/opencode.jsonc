{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "plan",
  "agents": {
    "build": {
      "color": "#5C9CF5"
    },
    "plan": {
      "color": "#FAB283"
    }
  },
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
        "disabled": true
      },
      "gitlab": {
        "type": "remote",
        "url": "https://gitlab.com/api/v4/mcp",
        "disabled": true
      },
      "playwright_chromium": {
        "type": "local",
        "command": [
          "playwright",
          "mcp",
          "--codegen",
          "typescript",
          "--isolated",
          "--headless",
          "--ignore-https-errors",
          "--executable-path",
          "/usr/bin/chromium"
        ],
        "disabled": true
      },
      "playwright_firefox": {
        "type": "local",
        "command": [
          "playwright",
          "mcp",
          "--codegen",
          "typescript",
          "--isolated",
          "--headless",
          "--ignore-https-errors",
          "--browser",
          "firefox"
        ],
        "disabled": true
      }
    }
  }
}
