{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "plan",
  "agents": {
    "build": {
      "color": "#5C9CF5"
    },
    "plan": {
      "color": "#FAB283"
    }
  },
  "formatter": true,
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp",
        "disabled": true
      },
      "gitlab": {
        "type": "remote",
        "url": "https://gitlab.com/api/v4/mcp",
        "disabled": true
      },
      // Use gitlab's cli tool `glab` as local mcp server.
      // This is a useful workaround  when gitlab remote mcp starts
      // spamming HTTP 429 errors.
      "glab": {
        "type": "local",
        "command": ["glab", "mcp", "serve"],
        "disabled": true
      },
      // Install the actual mcp with `r2pm -Uci r2mcp` if needed
      "radare2": {
        "type": "local",
        "command": ["r2pm", "-r", "r2mcp"],
        "disabled": true
      },
      "playwright_chromium": {
        "type": "local",
        "command": [
          "playwright",
          "mcp",
          "--codegen",
          "typescript",
          "--isolated",
          "--headless",
          "--ignore-https-errors",
          "--executable-path",
          "/usr/bin/chromium"
        ],
        "disabled": true
      },
      // Requires the matching Playwright-managed browser on each machine:
      //   playwright install firefox
      "playwright_firefox": {
        "type": "local",
        "command": [
          "playwright",
          "mcp",
          "--codegen",
          "typescript",
          "--isolated",
          "--headless",
          "--ignore-https-errors",
          "--browser",
          "firefox"
        ],
        "disabled": true
      },
      // Requires playwright browser extension installed and enabled on browser
      "playwright_chromium_extension": {
        "type": "local",
        "command": [
          "playwright",
          "mcp",
          "--extension",
          "--executable-path",
          "/usr/bin/chromium"
        ],
       "disabled": true
      }
    }
  }
}
