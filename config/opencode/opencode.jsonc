{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "plan",
  "agent": {
    "build": {
      "color": "secondary"
    },
    "plan": {
      "color": "primary"
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": false
    },
    "gitlab": {
      "type": "remote",
      "url": "https://gitlab.com/api/v4/mcp",
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp",
        "--isolated",
        "--ignore-https-errors",
        "--headless",
        "--sandbox",
        "--executable-path",
        "/usr/bin/chromium"
      ],
      "enabled": false
    }
  }
}
